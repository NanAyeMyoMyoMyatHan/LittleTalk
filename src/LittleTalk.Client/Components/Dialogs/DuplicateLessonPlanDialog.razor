@using LittleTalk.Client.Services.Features
@using LittleTalk.Model.Features.LessonPlans
@inject ILessonPlanApiClient LessonPlanApi
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Duplicate Lesson Plan</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            This will create an exact clone of "<strong>@SourceTitle</strong>" including all ordered teaching steps, vocabulary items, and activity attachments.
        </MudText>
        <MudTextField @bind-Value="_newTitle" Label="Title for the New Clone *" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DuplicateAsync" Disabled="@_isCloning">
            @if (_isCloning)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>Cloning...</span>
            }
            else
            {
                <span>Clone Lesson Plan</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int LessonPlanId { get; set; }

    [Parameter]
    public string SourceTitle { get; set; } = string.Empty;

    private string _newTitle = string.Empty;
    private bool _isCloning = false;

    protected override void OnInitialized()
    {
        _newTitle = $"{SourceTitle} (Copy)";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task DuplicateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle))
        {
            Snackbar.Add("Please enter a title for the duplicate lesson plan.", Severity.Warning);
            return;
        }

        _isCloning = true;
        try
        {
            var res = await LessonPlanApi.DuplicateLessonPlanAsync(LessonPlanId, new DuplicateLessonPlanRequestModel { NewTitle = _newTitle });
            if (res != null && res.IsSuccess && res.Data != null)
            {
                Snackbar.Add("Lesson plan duplicated successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(res.Data.LessonPlanId));
            }
            else
            {
                Snackbar.Add(res?.Message ?? "Failed to duplicate lesson plan.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCloning = false;
        }
    }
}
