@page "/login"
@layout Layout.AuthLayout
@using LittleTalk.Client.Services.Features
@using LittleTalk.Model.Features.Auth
@inject IAuthApiClient AuthApi
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Sign In - LittleTalk Kids English</PageTitle>

<MudPaper Elevation="4" Class="pa-8 pa-sm-10 rounded-2xl lt-card w-100" 
          Style="max-width: 460px; background-color: #FFFFFF; border: 1px solid rgba(226, 232, 240, 0.9); box-shadow: 0 20px 40px -15px rgba(74, 144, 226, 0.15) !important;">
    <div class="text-center mb-6">
        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mb-3 mx-auto" Style="width: 64px; height: 64px; box-shadow: 0 6px 16px rgba(74, 144, 226, 0.3);">
            <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" Size="Size.Large" />
        </MudAvatar>
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #2B6CB0; letter-spacing: -0.5px;">Welcome to LittleTalk!</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Kids English Speaking Teaching Management System</MudText>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 rounded-lg" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
            @_errorMessage
        </MudAlert>
    }

    <EditForm Model="@_loginModel" OnValidSubmit="HandleLoginAsync">
        <MudTextField @bind-Value="_loginModel.UsernameOrEmail" Label="Username or Email" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                      Required="true" RequiredError="Please enter your username or email" />

        <MudTextField @bind-Value="_loginModel.Password" Label="Password" 
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End" 
                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                      OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                      Required="true" RequiredError="Please enter your password" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" 
                   FullWidth="true" Size="Size.Large" Class="mt-2 py-3 rounded-xl" Disabled="@_isLoading"
                   Style="font-weight: 600; font-size: 1rem; box-shadow: 0 4px 14px rgba(74, 144, 226, 0.4);">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Signing In...</span>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                <span>Sign In</span>
            }
        </MudButton>
    </EditForm>

    <MudDivider Class="my-6" />

    <div class="text-center">
        <MudText Typo="Typo.caption" Style="color: #718096; font-weight: 700; letter-spacing: 0.5px;" Class="d-block mb-3">
            QUICK DEMO SIGN-IN ACCOUNTS
        </MudText>
        <div class="d-flex flex-column gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" FullWidth="true" Class="rounded-lg py-2"
                       StartIcon="@Icons.Material.Filled.AdminPanelSettings" OnClick="@(() => FillCredentials("admin", "Admin@123"))">
                Admin: System Administrator
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" FullWidth="true" Class="rounded-lg py-2"
                       StartIcon="@Icons.Material.Filled.School" OnClick="@(() => FillCredentials("teacher.sarah", "Teacher@123"))">
                Teacher: Sarah Jenkins (Lead)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Size="Size.Small" FullWidth="true" Class="rounded-lg py-2"
                       StartIcon="@Icons.Material.Filled.School" OnClick="@(() => FillCredentials("teacher.david", "Teacher@123"))">
                Teacher: David Miller (Phonics)
            </MudButton>
        </div>
    </div>
</MudPaper>

@code {
    private readonly LoginRequestModel _loginModel = new();
    private bool _showPassword = false;
    private bool _isLoading = false;
    private string? _errorMessage;

    private void FillCredentials(string user, string pass)
    {
        _loginModel.UsernameOrEmail = user;
        _loginModel.Password = pass;
        _errorMessage = null;
    }

    private async Task HandleLoginAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var res = await AuthApi.LoginAsync(_loginModel);
            if (res != null && res.IsSuccess && res.Data != null)
            {
                await AuthStateProvider.MarkUserAsAuthenticated(res.Data.Token, res.Data.User);
                Snackbar.Add($"Welcome back, {res.Data.User.FullName}!", Severity.Success);
                Nav.NavigateTo("/");
            }
            else
            {
                _errorMessage = res?.Message ?? "Invalid username or password.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Connection error. Make sure LittleTalk API server is running.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
